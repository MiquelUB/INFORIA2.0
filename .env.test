# .env.test - Variables para TestSprite E2E

# URLs Base para Tests
TEST_BASE_URL=http://localhost:3001
TEST_API_URL=http://localhost:3000/api
TEST_DASHBOARD_URL=http://localhost:3001/dashboard
TEST_PATIENTS_URL=http://localhost:3001/patients
TEST_SESSION_URL=http://localhost:3001/session
TEST_BILLING_URL=http://localhost:3001/my-account/billing

# Timeouts
TEST_TIMEOUT_SHORT=5000
TEST_TIMEOUT_MEDIUM=10000
TEST_TIMEOUT_LONG=30000
TEST_NETWORK_IDLE_TIMEOUT=5000

# Selectors y credenciales de prueba
TEST_LOGIN_EMAIL=test@example.com
TEST_LOGIN_PASSWORD=TestPassword123!
TEST_USER_NAME=Test User

# Configuración de Playwright
TEST_HEADLESS=true
TEST_SLOW_MO=0
TEST_VIEWPORT_WIDTH=1280
TEST_VIEWPORT_HEIGHT=720

# Banderas de Feature
TEST_ENABLE_SCREENSHOTS=true
TEST_SCREENSHOT_DIR=./test-results/screenshots
TEST_ENABLE_VIDEO=false
TEST_VIDEO_DIR=./test-results/videos

# Logging
TEST_LOG_LEVEL=info
TEST_LOG_FILE=./test-results/test.log

# API Tokens (para testing - valores ficticios)
TEST_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
TEST_STRIPE_KEY=pk_test_dummy
